# ============================================================
# Supabase — Settings → API del proyecto
# Copiar este archivo a .env.local y completar los valores.
# ============================================================

# Project URL, con https:// y sin barra final.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Clave publica ("anon" / "public", en proyectos nuevos "publishable").
# Viaja al navegador: toda consulta con esta clave pasa por RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
